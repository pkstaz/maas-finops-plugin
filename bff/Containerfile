ARG BUILD_IMAGE="registry.access.redhat.com/ubi9/go-toolset:latest"

FROM ${BUILD_IMAGE} AS builder
USER 0
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY pkg/ pkg/
RUN CGO_ENABLED=0 GOOS=linux go build -o /backend ./cmd/backend

FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

LABEL org.opencontainers.image.title="MaaS FinOps BFF"
LABEL org.opencontainers.image.description="Backend for the RHOAI MaaS FinOps community plugin"

WORKDIR /app
COPY --from=builder /backend /app/backend

ENV PORT=3000

RUN chown -R 1001:0 /app && chmod -R g=u /app
USER 1001
EXPOSE 3000

CMD ["/app/backend"]
